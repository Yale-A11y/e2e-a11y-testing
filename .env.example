# Example environment configuration
# Copy this file to .env and modify as needed

# Base URL for testing (used as fallback if not provided in commands)
TEST_URL=https://example.com

# Run tests in headed mode (useful for debugging)
# HEADED=true

# Custom timeout for tests (in milliseconds)
# TEST_TIMEOUT=60000

# Custom timeout for page navigation (in milliseconds)
# NAVIGATION_TIMEOUT=30000

# Maximum number of URLs to test from sitemap (performance limit)
# MAX_SITEMAP_URLS=1000

# Skip URLs containing these patterns (comma-separated)
# SKIP_URL_PATTERNS=/admin,/login,/private

# Browser to use for single-browser testing
# BROWSER=chromium

# Disable specific axe rules (comma-separated rule IDs)
# DISABLED_AXE_RULES=color-contrast,duplicate-id

# Enable experimental axe rules
# ENABLE_EXPERIMENTAL_RULES=false

# Custom path for browser binaries
# PLAYWRIGHT_BROWSERS_PATH=./browsers

# CI environment flag (automatically set in CI/CD)
# CI=false

# Debug flags for troubleshooting
# DEBUG=pw:api
# DEBUG=pw:browser
